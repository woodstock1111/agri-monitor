/* AI收成预测：沿用 app.wxss 的变量；绿色作为本页强调色（与农业语义一致） */
.hv {
  --hv-green: #3f7d62;
  --hv-green-press: #336a52;
  --hv-green-bg: #eaf3ee;
  padding: var(--gap) var(--gap) calc(64rpx + var(--safe-bottom));
}

.hv-hero {
  padding: 8rpx 8rpx var(--gap-md);
}
.hv-hero__eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--hv-green);
  font-weight: 600;
  letter-spacing: 2rpx;
}
.hv-hero__title {
  font-size: 48rpx;
  font-weight: 700;
  margin: 8rpx 0;
}
.hv-beta {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--hv-green);
  background: var(--hv-green-bg);
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.hv-hero__sub {
  display: block;
  color: var(--text-secondary);
  line-height: 1.6;
}

.hv-card {
  margin-bottom: var(--gap);
}
.hv-card__title {
  display: block;
  font-size: var(--fs-md);
  font-weight: 700;
  margin-bottom: var(--gap-sm);
}
.hv-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: var(--gap);
}
.hv-step__no {
  font-size: var(--fs-caption);
  font-weight: 700;
  color: var(--hv-green);
  background: var(--hv-green-bg);
  border-radius: var(--radius-sm);
  padding: 4rpx 12rpx;
}
.hv-step__title {
  font-size: var(--fs-lg);
  font-weight: 700;
}

/* —— 分段选择 —— */
.hv-seg {
  display: flex;
  background: var(--bg-base);
  border-radius: var(--radius-sm);
  padding: 6rpx;
  margin-bottom: var(--gap);
}
.hv-seg__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: var(--text-secondary);
  font-weight: 600;
  transition: background var(--dur-micro) var(--ease), color var(--dur-micro) var(--ease);
}
.hv-seg__item--on {
  background: var(--bg-surface);
  color: var(--hv-green);
  box-shadow: var(--shadow-sm);
}
.hv-seg__item--press {
  opacity: 0.7;
}

/* —— 表单 —— */
.hv-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: var(--gap);
}
.hv-field__label {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
.hv-field__value,
.hv-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-base);
  border-radius: var(--radius-sm);
  font-size: var(--fs-body);
  color: var(--text-primary);
  box-sizing: border-box;
}
.hv-input {
  height: 80rpx;
}
.hv-caret {
  color: var(--text-muted);
  font-size: var(--fs-lg);
  margin-left: 12rpx;
}
.hv-row {
  display: flex;
  gap: var(--gap-sm);
}
.hv-field--half { flex: 1; min-width: 0; }
.hv-field--third { flex: 1; min-width: 0; }
.hv-field--quarter { flex: 1; min-width: 0; }
.hv-field--quarter .hv-input,
.hv-field--third .hv-input {
  padding: 0 16rpx;
}
.hv-hint {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--gap-sm);
}
.hv-hint--pad {
  padding: 0 8rpx;
}
.hv-link {
  color: var(--hv-green);
  font-weight: 600;
  font-size: var(--fs-caption);
}

/* —— 土壤状态 —— */
.hv-soil {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-base);
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
.hv-soil--idle { display: none; }
.hv-soil--ready { background: var(--hv-green-bg); color: var(--hv-green); }
.hv-soil--error { background: var(--warning-bg); color: #9a6a12; }
.hv-soil__text { flex: 1; min-width: 60%; line-height: 1.6; }
.hv-soil__actions { display: flex; gap: 24rpx; }
.hv-soil__spin {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid var(--border-strong);
  border-top-color: var(--hv-green);
  border-radius: 50%;
  animation: hvSpin 0.8s linear infinite;
}
@keyframes hvSpin {
  to { transform: rotate(360deg); }
}

/* —— 折叠区 —— */
.hv-more {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 4rpx;
  border-top: 1rpx solid var(--border);
  font-weight: 600;
  color: var(--text-secondary);
}
.hv-more--press { opacity: 0.7; }
.hv-more__icon {
  font-size: var(--fs-lg);
  transition: transform var(--dur-state) var(--ease);
}
.hv-more__icon--open { transform: rotate(90deg); }
.hv-more__body { padding-top: var(--gap); }

/* —— 主按钮 —— */
.hv-run {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 32rpx 24rpx;
  margin-bottom: var(--gap-md);
  background: var(--hv-green);
  color: var(--text-inverse);
  border-radius: var(--radius);
  box-shadow: 0 12rpx 32rpx rgba(63, 125, 98, 0.25);
  transition: transform var(--dur-micro) var(--ease), background var(--dur-micro) var(--ease);
}
.hv-run--press {
  background: var(--hv-green-press);
  transform: scale(0.98);
}
.hv-run--busy {
  pointer-events: none;
  background: var(--hv-green-press);
}
.hv-run__title {
  font-size: var(--fs-lg);
  font-weight: 700;
}
.hv-run__sub {
  font-size: var(--fs-caption);
  opacity: 0.85;
}
.hv-run__track {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}
.hv-run__bar {
  width: 40%;
  height: 100%;
  background: rgba(255, 255, 255, 0.85);
  animation: hvSlide 1.2s var(--ease) infinite;
}
@keyframes hvSlide {
  from { transform: translateX(-100%); }
  to { transform: translateX(250%); }
}

/* —— 结果 —— */
.hv-result__inner {
  transition: opacity var(--dur-state) var(--ease);
}
.hv-result__inner--stale {
  opacity: 0.5;
}
.hv-stale {
  font-size: var(--fs-caption);
  color: #9a6a12;
  background: var(--warning-bg);
  border-radius: var(--radius-sm);
  padding: 12rpx 20rpx;
  margin-bottom: var(--gap-sm);
}
.hv-error {
  border-color: #f5c2c2;
  background: var(--danger-bg);
}
.hv-error__title {
  display: block;
  font-weight: 700;
  color: var(--danger);
  margin-bottom: 8rpx;
}
.hv-error__text {
  color: var(--text-primary);
}


.hv-tone--ok { --tone: var(--hv-green); --tone-bg: var(--hv-green-bg); }
.hv-tone--warn { --tone: #b7791f; --tone-bg: var(--warning-bg); }
.hv-tone--bad { --tone: #c0392b; --tone-bg: var(--danger-bg); }
.hv-tone--unknown { --tone: var(--text-secondary); --tone-bg: var(--bg-base); }

.hv-verdict {
  margin-bottom: var(--gap);
  border-left: 8rpx solid var(--tone);
}
.hv-verdict__eyebrow {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
.hv-verdict__title {
  display: block;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--tone);
  margin: 8rpx 0;
}
.hv-verdict__detail {
  display: block;
  line-height: 1.6;
}
.hv-verdict__foot {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-muted);
  margin-top: var(--gap-sm);
}
.hv-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--gap-sm);
}
.hv-chip {
  font-size: var(--fs-caption);
  background: var(--bg-base);
  color: var(--text-secondary);
  border-radius: var(--radius-pill);
  padding: 6rpx 18rpx;
}

.hv-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap-sm);
  margin-bottom: var(--gap);
}
.hv-metric {
  background: var(--bg-panel);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: var(--gap);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.hv-metric__label {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
.hv-metric__value {
  font-size: 48rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}
.hv-metric__value--sm {
  font-size: var(--fs-lg);
}
.hv-metric__note {
  font-size: var(--fs-caption);
  color: var(--text-muted);
}

.hv-issue {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  line-height: 1.6;
}
.hv-issue__dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #b7791f;
}

/* —— 年景柱图（柱高 = 产量/最高产量，最高 200rpx） —— */
.hv-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 280rpx;
  padding-top: 16rpx;
}
.hv-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}
.hv-bar__val {
  font-size: 18rpx;
  color: var(--text-muted);
  white-space: nowrap;
}
.hv-bar__col {
  width: 70%;
  border-radius: 6rpx 6rpx 0 0;
  background: #8fb3a0;
}
.hv-bar__col--best { background: var(--hv-green); }
.hv-bar__col--worst { background: #d98a5b; }
.hv-bar__year {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.hv-cost {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--gap-sm);
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.hv-cost--total {
  border-bottom: none;
  font-weight: 700;
}
.hv-cost__left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.hv-cost__note {
  font-size: var(--fs-caption);
  color: var(--text-muted);
}
.hv-cost__value {
  flex: none;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}
.hv-fert {
  margin-top: var(--gap-sm);
  padding: var(--gap-sm) var(--gap);
  border-radius: var(--radius-sm);
  background: var(--tone-bg);
}
.hv-fert__title {
  display: block;
  font-weight: 700;
  color: var(--tone);
}
.hv-fert__text {
  display: block;
  font-size: var(--fs-caption);
  line-height: 1.6;
  color: var(--text-secondary);
}
.hv-fert__text--strong {
  color: var(--text-primary);
  margin-top: 6rpx;
}

.hv-factor {
  padding: 14rpx 0;
}
.hv-factor__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.hv-factor__name {
  font-weight: 600;
}
.hv-factor__chip {
  font-size: var(--fs-caption);
  color: var(--tone);
  background: var(--tone-bg);
  border-radius: var(--radius-pill);
  padding: 4rpx 16rpx;
}
.hv-track {
  height: 10rpx;
  background: var(--bg-base);
  border-radius: var(--radius-pill);
  overflow: hidden;
}
.hv-track__fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--text-muted);
  transition: width var(--dur-page) var(--ease);
}
.hv-track__fill--ok { background: var(--hv-green); }
.hv-track__fill--warn { background: #d69e2e; }
.hv-track__fill--bad { background: #d9534f; }
.hv-factor__text {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-secondary);
  line-height: 1.6;
}

.hv-source {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1.6;
}
