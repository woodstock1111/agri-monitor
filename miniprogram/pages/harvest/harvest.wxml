<view class="hv">
  <view class="hv-hero">
    <text class="hv-hero__eyebrow">种植决策 · 从一块地开始</text>
    <view class="hv-hero__title">AI收成预测<text class="hv-beta">Beta</text></view>
    <text class="hv-hero__sub">用过去多年的真实天气逐日模拟，看这块地能不能种、大概收多少、能赚多少。</text>
  </view>

  <!-- 01 作物与地块 -->
  <view class="card hv-card">
    <view class="hv-step"><text class="hv-step__no">01</text><text class="hv-step__title">作物与地块</text></view>
    <view class="hv-seg">
      <block wx:for="{{crops}}" wx:key="value">
        <view class="hv-seg__item {{index === cropIndex ? 'hv-seg__item--on' : ''}}" hover-class="hv-seg__item--press" hover-stay-time="80" data-index="{{index}}" bindtap="onCrop">{{item.label}}</view>
      </block>
    </view>
    <picker range="{{places}}" range-key="label" value="{{placeIndex}}" bindchange="onPlace">
      <view class="hv-field">
        <text class="hv-field__label">位置</text>
        <view class="hv-field__value">{{places[placeIndex].label || '选择地块'}}<text class="hv-caret">›</text></view>
      </view>
    </picker>
    <text wx:if="{{pointText}}" class="hv-hint">{{pointText}}</text>
    <view class="hv-soil hv-soil--{{soilState}}">
      <view wx:if="{{soilState === 'loading'}}" class="hv-soil__spin"></view>
      <text class="hv-soil__text">{{soilText}}</text>
      <view wx:if="{{soilState === 'error'}}" class="hv-soil__actions">
        <text class="hv-link" bindtap="loadSoil">重试</text>
        <text class="hv-link" bindtap="onUseManual">改用示例养分</text>
      </view>
    </view>
  </view>

  <!-- 02 种植条件 -->
  <view class="card hv-card">
    <view class="hv-step"><text class="hv-step__no">02</text><text class="hv-step__title">怎么种</text></view>
    <view class="hv-seg">
      <view class="hv-seg__item {{dateMode === 'auto' ? 'hv-seg__item--on' : ''}}" hover-class="hv-seg__item--press" hover-stay-time="80" data-mode="auto" bindtap="onDateMode">帮我挑种植月份</view>
      <view class="hv-seg__item {{dateMode === 'manual' ? 'hv-seg__item--on' : ''}}" hover-class="hv-seg__item--press" hover-stay-time="80" data-mode="manual" bindtap="onDateMode">我定日期</view>
    </view>
    <picker wx:if="{{dateMode === 'manual'}}" mode="date" value="{{date}}" bindchange="onDate">
      <view class="hv-field">
        <text class="hv-field__label">种植 / 移栽日期</text>
        <view class="hv-field__value">{{date}}<text class="hv-caret">›</text></view>
      </view>
    </picker>
    <text wx:else class="hv-hint">比较 12 个月的种植时间，先排除不能种的月份，再选平均收成最好的。</text>
    <view class="hv-row">
      <view class="hv-field hv-field--half">
        <text class="hv-field__label">面积（亩）</text>
        <input class="hv-input" type="digit" value="{{area}}" data-key="area" bindinput="onNumber" />
      </view>
      <view class="hv-field hv-field--half">
        <text class="hv-field__label">生育期（天）</text>
        <input class="hv-input" type="number" value="{{days}}" data-key="days" bindinput="onNumber" />
      </view>
    </view>
    <picker range="{{waterOptions}}" range-key="label" value="{{waterIndex}}" data-key="waterIndex" bindchange="onPicker">
      <view class="hv-field">
        <text class="hv-field__label">供水</text>
        <view class="hv-field__value">{{waterOptions[waterIndex].label}}<text class="hv-caret">›</text></view>
      </view>
    </picker>
    <picker range="{{drainageOptions}}" range-key="label" value="{{drainageIndex}}" data-key="drainageIndex" bindchange="onPicker">
      <view class="hv-field">
        <text class="hv-field__label">排水</text>
        <view class="hv-field__value">{{drainageOptions[drainageIndex].label}}<text class="hv-caret">›</text></view>
      </view>
    </picker>

    <view class="hv-more" hover-class="hv-more--press" hover-stay-time="80" bindtap="onToggleMore">
      <text>土壤、售价与成本</text>
      <text class="hv-more__icon {{moreOpen ? 'hv-more__icon--open' : ''}}">›</text>
    </view>
    <view wx:if="{{moreOpen}}" class="hv-more__body">
      <picker range="{{soilOptions}}" range-key="label" value="{{soilIndex}}" data-key="soilIndex" bindchange="onPicker">
        <view class="hv-field">
          <text class="hv-field__label">养分数据</text>
          <view class="hv-field__value">{{soilOptions[soilIndex].label}}<text class="hv-caret">›</text></view>
        </view>
      </picker>
      <picker range="{{textureOptions}}" range-key="label" value="{{textureIndex}}" data-key="textureIndex" bindchange="onPicker">
        <view class="hv-field">
          <text class="hv-field__label">土壤质地</text>
          <view class="hv-field__value">{{textureOptions[textureIndex].label}}<text class="hv-caret">›</text></view>
        </view>
      </picker>
      <block wx:if="{{soilOptions[soilIndex].value === 'manual'}}">
        <text class="hv-hint">整季可吸收供应（kg/公顷），不是化验浓度 mg/kg。</text>
        <view class="hv-row">
          <view class="hv-field hv-field--quarter"><text class="hv-field__label">pH</text><input class="hv-input" type="digit" value="{{ph}}" data-key="ph" bindinput="onNumber" /></view>
          <view class="hv-field hv-field--quarter"><text class="hv-field__label">氮 N</text><input class="hv-input" type="digit" value="{{n}}" data-key="n" bindinput="onNumber" /></view>
          <view class="hv-field hv-field--quarter"><text class="hv-field__label">磷 P</text><input class="hv-input" type="digit" value="{{p}}" data-key="p" bindinput="onNumber" /></view>
          <view class="hv-field hv-field--quarter"><text class="hv-field__label">钾 K</text><input class="hv-input" type="digit" value="{{k}}" data-key="k" bindinput="onNumber" /></view>
        </view>
      </block>
      <block wx:if="{{soilOptions[soilIndex].value !== 'climate'}}">
        <view class="hv-row">
          <view class="hv-field hv-field--third"><text class="hv-field__label">售价 元/kg</text><input class="hv-input" type="digit" value="{{price}}" data-key="price" bindinput="onNumber" /></view>
          <view class="hv-field hv-field--third"><text class="hv-field__label">基础成本/亩</text><input class="hv-input" type="digit" value="{{base}}" data-key="base" bindinput="onNumber" /></view>
          <view class="hv-field hv-field--third"><text class="hv-field__label">肥料预算/亩</text><input class="hv-input" type="digit" value="{{budget}}" data-key="budget" bindinput="onNumber" /></view>
        </view>
        <text class="hv-hint">默认值只是示例。基础成本含种苗、人工、地租；灌溉费按 0.5 元/立方米参考价另算。</text>
      </block>
    </view>
  </view>

  <!-- 03 开始分析 -->
  <view class="hv-run {{running ? 'hv-run--busy' : ''}}" hover-class="hv-run--press" hover-stay-time="80" bindtap="onRun">
    <text class="hv-run__title">{{running ? '正在分析…' : view ? (stale ? '条件已修改 · 重新分析' : '重新分析') : '分析这个地块'}}</text>
    <text class="hv-run__sub">{{running ? stage : '读取多年天气并逐日计算，约需几秒到十几秒'}}</text>
    <view wx:if="{{running}}" class="hv-run__track"><view class="hv-run__bar"></view></view>
  </view>

  <!-- 结果 -->
  <view id="result" class="hv-result">
    <view wx:if="{{error}}" class="card hv-card hv-error">
      <text class="hv-error__title">这次没有算完</text>
      <text class="hv-error__text">{{error}}</text>
    </view>

    <block wx:if="{{view && !error}}">
      <view class="hv-result__inner {{stale || running ? 'hv-result__inner--stale' : ''}}">
        <view wx:if="{{stale}}" class="hv-stale">条件已修改，下面是上次的结果。</view>

        <view class="card hv-verdict hv-tone--{{view.tone}}">
          <text class="hv-verdict__eyebrow">{{view.crop}} · Beta</text>
          <text class="hv-verdict__title">{{view.headline}}</text>
          <text class="hv-verdict__detail">{{view.detail}}</text>
          <text class="hv-verdict__foot">{{view.footnote}}</text>
          <view class="hv-chips">
            <text class="hv-chip">{{view.waterText}}</text>
            <text wx:if="{{view.irrigation}}" class="hv-chip">{{view.irrigation}}</text>
            <text class="hv-chip">气候条件分 {{view.climateScore}}/100</text>
          </view>
        </view>

        <view wx:if="{{view.yieldAvailable}}" class="hv-metrics">
          <view class="hv-metric">
            <text class="hv-metric__label">预计收成 kg/亩</text>
            <text class="hv-metric__value">{{view.yieldText}}</text>
            <text class="hv-metric__note">平均 {{view.yieldMean}}</text>
          </view>
          <view class="hv-metric">
            <text class="hv-metric__label">平均利润 元/亩</text>
            <text class="hv-metric__value">{{view.net}}</text>
            <text class="hv-metric__note">较差年份 {{view.netLow}}</text>
          </view>
          <view class="hv-metric">
            <text class="hv-metric__label">可出售 kg/亩</text>
            <text class="hv-metric__value hv-metric__value--sm">{{view.saleable}}</text>
            <text class="hv-metric__note">商品率 85%</text>
          </view>
          <view class="hv-metric">
            <text class="hv-metric__label">保本售价</text>
            <text class="hv-metric__value hv-metric__value--sm">{{view.breakEven}}</text>
            <text class="hv-metric__note">{{view.lossShare}}% 的年份亏损</text>
          </view>
        </view>
        <view wx:else class="card hv-card"><text class="hv-hint">只看天气模式：不计算产量和收益。要看收成，请在“土壤、售价与成本”里选择土壤数据或示例养分。</text></view>
        <text wx:if="{{view.yieldAvailable && !view.supported}}" class="hv-hint hv-hint--pad">未通过可行性检查：产量和利润仅作试验估算。</text>

        <view wx:if="{{view.issues.length}}" class="card hv-card">
          <text class="hv-card__title">需要注意的问题</text>
          <block wx:for="{{view.issues}}" wx:key="*this">
            <view class="hv-issue"><view class="hv-issue__dot"></view><text>{{item}}</text></view>
          </block>
        </view>

        <view wx:if="{{view.bars.length}}" class="card hv-card">
          <text class="hv-card__title">如果遇上不同年景</text>
          <text class="hv-hint">同一套种植方案，在过去每一年的天气下的鲜薯产量（kg/亩）</text>
          <view class="hv-bars">
            <block wx:for="{{view.bars}}" wx:key="year">
              <view class="hv-bar">
                <text class="hv-bar__val">{{item.value}}</text>
                <view class="hv-bar__col hv-bar__col--{{item.tag}}" style="height:{{item.height * 2}}rpx"></view>
                <text class="hv-bar__year">'{{item.year}}</text>
              </view>
            </block>
          </view>
        </view>

        <view wx:if="{{view.yieldAvailable}}" class="card hv-card">
          <text class="hv-card__title">预计成本 · 元/亩</text>
          <block wx:for="{{view.costs}}" wx:key="name">
            <view class="hv-cost {{index === view.costs.length - 1 ? 'hv-cost--total' : ''}}">
              <view class="hv-cost__left"><text class="hv-cost__name">{{item.name}}</text><text class="hv-cost__note">{{item.note}}</text></view>
              <text class="hv-cost__value">{{item.value}}</text>
            </view>
          </block>
          <view wx:if="{{view.fertilizer}}" class="hv-fert hv-tone--{{view.fertilizer.tone}}">
            <text class="hv-fert__title">施肥需求：{{view.fertilizer.level}}</text>
            <text class="hv-fert__text">{{view.fertilizer.summary}}</text>
            <text wx:if="{{view.fertilizer.advice}}" class="hv-fert__text hv-fert__text--strong">{{view.fertilizer.advice}}</text>
          </view>
        </view>

        <view class="card hv-card">
          <text class="hv-card__title">是什么限制了生长</text>
          <block wx:for="{{view.factors}}" wx:key="id">
            <view class="hv-factor">
              <view class="hv-factor__head">
                <text class="hv-factor__name">{{item.name}}</text>
                <text class="hv-factor__chip hv-tone--{{item.tone}}">{{item.statusText}}{{item.score ? ' · ' + item.score : ''}}</text>
              </view>
              <view class="hv-track"><view class="hv-track__fill hv-track__fill--{{item.tone}}" style="width:{{item.width}}%"></view></view>
              <text class="hv-factor__text">{{item.evidence}}</text>
            </view>
          </block>
        </view>

        <view class="hv-source">
          <text>{{view.source}}</text>
          <text>{{view.version}}</text>
          <text>Beta：参数尚未做地区验证，结果用于比较情景，不是施肥或种植处方。水分曲线、逐年明细和导出请到网页版查看。</text>
        </view>
      </view>
    </block>
  </view>
</view>
