/* 封面 · 地块台账（纸面风格，与全程一致） */
page {
  background: #f2efde;
}

.cover {
  padding: 0 36rpx;
  box-sizing: border-box;
}

/* ===== 抬头 ===== */
.head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 0 34rpx;
}
.head__company {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #526454;
  letter-spacing: 2rpx;
}
.head__company-ph { color: #9ca48e; font-weight: 500; }
.head__title {
  font-size: 52rpx;
  font-weight: 800;
  color: #354b3d;
  letter-spacing: 6rpx;
}
.head__rule {
  margin-top: 14rpx;
  width: 120rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #b68169;
}

/* ===== 台账区 ===== */
.ledger__bar {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.ledger__label {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #526454;
}
.ledger__count {
  margin-left: auto;
  font-size: 21rpx;
  color: #7e8778;
}

.card {
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  border-radius: 24rpx;
  padding: 24rpx 26rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 3rpx 10rpx rgba(53, 75, 61, 0.05);
}
.card__top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.card__name {
  flex: 1;
  min-width: 0;
  font-size: 33rpx;
  font-weight: 800;
  color: #354b3d;
  letter-spacing: 1rpx;
  border-bottom: 1rpx dashed rgba(53, 75, 61, 0.22);
  padding-bottom: 8rpx;
}
.card__del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(176, 80, 58, 0.08);
  border: 1rpx solid rgba(176, 80, 58, 0.20);
  color: #b0503a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.card__del--press { transform: scale(0.9); }

.card__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx 20rpx;
}
.f {
  background: #e9e8d8;
  border: 1rpx solid rgba(53, 75, 61, 0.10);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.f--wide { grid-column: span 2; }
.f__label {
  font-size: 20rpx;
  color: #7e8778;
  letter-spacing: 1rpx;
}
.f__input {
  font-size: 27rpx;
  font-weight: 600;
  color: #354b3d;
  height: 44rpx;
  line-height: 44rpx;
}
.f__picker { display: flex; align-items: center; }
.f__picker--empty { color: #9ca48e; font-weight: 500; }
.f-ph { color: #9ca48e; font-weight: 500; }

/* 添加地块 */
.add {
  margin-top: 6rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #526f54;
  background: rgba(192, 130, 79, 0.06);
  border: 2rpx dashed rgba(192, 130, 79, 0.45);
  border-radius: 20rpx;
  transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1);
}
.add--press { transform: scale(0.97); }

/* 卡片底部：地图查看 */
.card__foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(53, 75, 61, 0.16);
}
.card__map {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #526f54;
  background: rgba(95, 122, 78, 0.10);
  border: 1rpx solid rgba(95, 122, 78, 0.24);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1);
}
.card__map--press { transform: scale(0.94); }
.card__map-pin { font-size: 22rpx; }
.card__map-arrow { font-size: 28rpx; font-weight: 700; margin-top: -4rpx; }

/* 给底部固定页脚让位 */
.cover__pad { height: 240rpx; }

/* ===== 进入地图：底部固定层（无硬线），整层挡住后面的输入框与触摸 ===== */
.enter {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  /* 顶部一小段渐隐过渡（柔，无线），按钮所在区为不透明，彻底盖住后面文字 */
  padding-top: 56rpx;
  background: linear-gradient(180deg, rgba(242, 239, 222, 0) 0, rgba(242, 239, 222, 0.96) 56rpx, #f2efde 56rpx);
}
.enter__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 320rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #526f54;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.30),
    0 8rpx 22rpx rgba(192, 130, 79, 0.40);
  transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1);
}
.enter__btn--press { transform: scale(0.96); }
.enter__text {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #fff;
}
.enter__arrow {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  margin-top: -4rpx;
}

.head__title { font-size:44rpx;font-weight:600;letter-spacing:2rpx; }
.card { box-shadow:none; }
.enter__btn { background:#526f54;box-shadow:0 6rpx 18rpx rgba(53,75,61,.14); }
