<view class="map-root {{mapReady ? 'map-root--ready' : ''}} {{pageLeaving ? 'map-root--leaving' : ''}} {{pageReturn ? 'map-root--return' : ''}}">
  <movable-area class="map-area" style="top:{{mapTop}}px;width:{{vw}}px;height:{{mapHeight}}px">
    <movable-view class="map-box" direction="all" inertia damping="40" friction="3" out-of-bounds="{{false}}"
      x="{{mapX}}" y="{{mapY}}" animation="{{mapAnimate}}" style="width:{{boxW}}px;height:{{boxH}}px"
      bindchange="onMapChange" bindtap="onMapTap">
     <view class="map-world" style="left:{{-boxX}}px;top:{{-boxY}}px;width:{{worldW}}px;height:{{worldH}}px">
      <image class="map-art" src="/assets/park/park-world.jpg" mode="scaleToFill" style="width:{{worldW}}px;height:{{worldH}}px" bindload="onMapArtLoad" />
      <!-- Fog outside the unlocked area; while unlocking, the old layer fades out under the new one. -->
      <view wx:if="{{fogPrev}}" class="fog-layer {{fogPrev.entering || fogPrev.out ? 'fog-layer--hidden' : ''}}" style="width:{{worldW}}px;height:{{worldH}}px">
        <view class="fog-wash" style="width:{{worldW}}px;{{fogPrev.wash}}"></view>
        <image wx:for="{{fogPrev.puffs}}" wx:key="id" class="fog-puff {{item.flip ? 'fog-puff--flip' : ''}}" src="/assets/park/fog.png" mode="scaleToFill" style="{{item.style}}" />
      </view>
      <view wx:if="{{fogNow}}" class="fog-layer {{fogNow.entering || fogNow.out ? 'fog-layer--hidden' : ''}}" style="width:{{worldW}}px;height:{{worldH}}px">
        <view class="fog-wash" style="width:{{worldW}}px;{{fogNow.wash}}"></view>
        <image wx:for="{{fogNow.puffs}}" wx:key="id" class="fog-puff {{item.flip ? 'fog-puff--flip' : ''}}" src="/assets/park/fog.png" mode="scaleToFill" style="{{item.style}}" />
      </view>
      <block wx:for="{{plots}}" wx:key="id">
        <block wx:if="{{item.mapped}}">
          <image class="plot-glow {{item.id === focusId ? 'plot-glow--on' : ''}}" src="{{item.glowSrc}}" style="{{item.glowStyle}}" />
          <view class="plot-tag {{item.id === focusId ? 'plot-tag--on' : ''}}" style="left:{{item.tagX}}px;top:{{item.tagY}}px">
            <view class="plot-tag__dot" style="background:{{item.swatch}}"></view>
            <view class="plot-tag__text"><text class="plot-tag__name">{{item.name || '未命名地块'}}</text><text class="plot-tag__crop">{{item.crop && item.crop !== '未填写品种' ? item.crop : '未填品种'}}</text></view>
            <view wx:if="{{item.sensor && item.sensor.alarmLevel > 0}}" class="plot-tag__alarm"></view>
          </view>
        </block>
      </block>
     </view>
    </movable-view>
  </movable-area>
  <!-- Clouds part over the map on entry. -->
  <view wx:if="{{introVisible}}" class="intro {{introOpen ? 'intro--open' : ''}}" style="top:{{mapTop}}px;height:{{mapHeight}}px">
    <image class="intro__cloud intro__cloud--l" src="/assets/park/fog.png" mode="scaleToFill" />
    <image class="intro__cloud intro__cloud--r" src="/assets/park/fog.png" mode="scaleToFill" />
    <image class="intro__cloud intro__cloud--c" src="/assets/park/fog.png" mode="scaleToFill" />
  </view>
  <view class="topbar" style="padding-top:{{statusBarHeight + 12}}px">
    <view class="topbar__heading">
      <view class="topbar__back" hover-class="control--press" bindtap="onBackCover">‹</view>
      <text class="topbar__title">{{parkTitle}}</text>
    </view>
    <view class="topbar__subrow">
      <text class="topbar__count">{{mapReady ? plots.length + ' 个地块 · 拖动浏览' : '正在准备园区'}}</text>
      <view class="topbar__ledger" hover-class="control--press" bindtap="onOpenLedger">＋ 地块台账</view>
    </view>
  </view>
  <view wx:if="{{!mapReady}}" class="map-state">
    <view class="map-state__mark"></view>
    <text>{{loadError || '正在铺开这片田园…'}}</text>
    <view wx:if="{{loadError}}" class="map-state__retry" bindtap="loadPlots">重新加载</view>
  </view>
  <view wx:elif="{{!plots.length}}" class="map-empty"><text>还没有地块</text><text class="map-empty__sub">在地块台账中管理你的土地</text></view>
  <view class="park-shelf {{sheetVisible ? 'park-shelf--hidden' : ''}}" style="padding-bottom:{{safeBottom}}px">
    <view wx:if="{{selectedPlot}}" class="plot-selector" bindtouchstart="onSelectorStart" bindtouchend="onSelectorEnd" bindtouchcancel="onSelectorCancel">
      <view class="selector-arrow {{selectedIndex <= 0 ? 'selector-arrow--disabled' : ''}}" hover-class="control--press" catchtap="onPreviousPlot">‹</view>
      <view class="selector-info selector-info--{{selectorParity ? 'a' : 'b'}}"><view class="selector-swatch" style="background:{{selectedPlot.swatch}}"></view><view class="selector-text"><text class="selector-name">{{selectedPlot.name}}</text><text class="selector-meta">{{selectedPlot.mapped ? selectedPlot.crop : '尚未标注'}} · {{selectedPlot.area}}亩</text></view></view>
      <view class="selector-arrow {{selectedIndex >= plots.length - 1 ? 'selector-arrow--disabled' : ''}}" hover-class="control--press" catchtap="onNextPlot">›</view>
      <view class="selector-enter" hover-class="control--press" catchtap="onEnterSelected">{{detailLoading ? '加载中' : '进入 ↗'}}</view>
    </view>
    <view class="park-nav">
      <view class="park-nav__item" hover-class="control--press" bindtap="onOpenAiPanel"><image class="park-nav__icon" src="/assets/park/steward.png" /><text>智能管家</text></view>
      <view class="park-nav__item" hover-class="control--press" bindtap="onOpenAgent"><image class="park-nav__icon" src="/assets/park/chat.png" /><text>问小薯</text></view>
      <view class="park-nav__item" hover-class="control--press" bindtap="onOpenRipePanel"><image class="park-nav__icon" src="/assets/park/maturity.png" /><text>成熟度</text></view>
      <view class="park-nav__item" hover-class="control--press" bindtap="onOpenHarvest"><image class="park-nav__icon" src="/assets/park/harvest.png" /><text>收成预测</text></view>
    </view>
  </view>

  <!-- 详情 + 小薯 共用一个 page-container（同页多个 page-container 只有第一个生效，故合并） -->
  <page-container
    show="{{sheetVisible}}"
    position="bottom"
    round="{{true}}"
    overlay="{{true}}"
    duration="320"
    bind:beforeleave="onSheetBeforeLeave"
    bind:afterleave="onSheetLeave"
    custom-style="height:{{agentOpen ? '86vh' : '80vh'}};background:#f2efde"
  >
   <view class="sheet-content">
   <block wx:if="{{detailOpen}}">
    <view class="detail__grab"></view>
    <view class="detail__head">
      <view class="detail__title-wrap">
        <text class="detail__title">{{detail.plot.name}}</text>
        <text class="detail__meta">{{detail.plot.crop}} · {{detail.plot.area}} 亩 · {{detail.plot.manager}} 负责</text>
        <text class="detail__meta detail__meta--dim">种植于 {{detail.plot.plantDate}}</text>
      </view>
      <view class="detail__close" catchtap="closeDetail">✕</view>
    </view>

    <scroll-view scroll-y class="detail__scroll" style="height:{{detailScrollH}}px">
     <view class="detail__inner">
      <view class="detail__section-title">传感器</view>
      <view wx:if="{{detail.devices.length}}" class="sensor-wrap">
        <block wx:for="{{detail.devices}}" wx:key="id" wx:for-item="dev">
          <view class="sensor-dev">
            <view class="sensor-dev__head">
              <text class="sensor-dev__name">{{dev.name}}</text>
              <text class="sensor-dev__state {{dev.online ? '' : 'sensor-dev__state--off'}}">{{dev.online ? '在线' : '离线'}}</text>
            </view>
            <view class="sensor-grid">
              <block wx:for="{{dev.factors}}" wx:key="registerName" wx:for-item="f">
                <view class="sfactor sfactor--lv{{f.alarmLevel}}">
                  <text class="sfactor__name">{{f.registerName}}</text>
                  <text class="sfactor__val">{{f.value}}<text class="sfactor__unit">{{f.unit}}</text></text>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
      <view wx:else class="detail__empty">该地块暂无传感器</view>

      <view class="detail__section-title detail__section-title--row">
        <text>农事</text>
        <view class="add-btn" catchtap="onAddTask">+ 新增</view>
      </view>
      <block wx:if="{{detail.tasks.length}}">
        <block wx:for="{{detail.tasks}}" wx:key="id" wx:for-item="task">
          <view class="dtask {{task.status === 'done' ? 'dtask--done' : ''}}">
            <view class="dtask__body">
              <text class="dtask__title">{{task.title}}</text>
              <view wx:if="{{task.aiReason}}" class="dtask__why">
                <text class="dtask__why-tag">小薯</text>
                <text class="dtask__why-text">{{task.aiReason}}</text>
              </view>
              <view class="dtask__tags">
                <text wx:if="{{task.type === 'ai'}}" class="dtask__tag dtask__tag--ai">AI</text>
                <text class="dtask__tag">{{task.date}}</text>
              </view>
            </view>
            <view
              wx:if="{{task.status !== 'done'}}"
              class="dtask__done-btn"
              hover-class="dtask__done-btn--press"
              hover-stay-time="80"
              data-id="{{task.id}}"
              catchtap="onCompleteTask"
            >完成</view>
            <view wx:else class="dtask__done-tag">✓ 已完成</view>
          </view>
        </block>
      </block>
      <view wx:else class="detail__empty">这块地还没有农事，点「新增」加一条</view>
      <view class="detail__pad"></view>
     </view>
    </scroll-view>
   </block>

   <block wx:elif="{{agentOpen}}">
    <view class="agent-body">
      <view class="agent-head">
        <text class="agent-head__title">小薯智能Agent</text>
        <view class="agent-head__clear" hover-class="agent-head__clear--press" hover-stay-time="80" catchtap="clearChat">清空</view>
        <view class="agent-close" hover-class="agent-close--press" hover-stay-time="80" catchtap="onCloseAgent">✕</view>
      </view>

      <view class="chat">
        <scroll-view scroll-y class="chat__list" scroll-into-view="{{scrollTo}}" scroll-with-animation>
         <view class="chat__inner">
          <view class="chat__pad"></view>
          <block wx:for="{{messages}}" wx:key="id">
            <view id="msg-{{item.id}}" class="row row--{{item.role}}">
              <image wx:if="{{item.role === 'assistant' && !item.thinking}}" class="ava" src="/assets/agent-sweet-potato.png" mode="aspectFit"></image>
              <view class="bubble bubble--{{item.role}} {{item.thinking ? 'bubble--think' : ''}}">
                <image wx:if="{{item.image}}" class="bubble__img" src="{{item.image}}" mode="widthFix"></image>
                <text wx:if="{{item.text}}" class="bubble__text" selectable>{{item.text}}</text>
                <view wx:if="{{item.thinking}}" class="think">
                  <image class="think__spud" src="/assets/agent-sweet-potato.png" mode="aspectFit"></image>
                  <view class="think__texts">
                    <text class="think__line">小薯思考中…</text>
                    <text class="think__line">正在翻土找资料…</text>
                    <text class="think__line">翻翻虫草图鉴…</text>
                    <text class="think__line">马上就有答案啦…</text>
                  </view>
                </view>
              </view>
            </view>
          </block>
          <view class="chat__pad"></view>
         </view>
        </scroll-view>

        <view class="inputbar" style="padding-bottom:{{kbHeight ? kbHeight : safeBottom}}px">
          <view wx:if="{{pendingImage}}" class="attach">
            <image class="attach__img" src="{{pendingImage}}" mode="aspectFill"></image>
            <view class="attach__rm" catchtap="removeChatImage">✕</view>
          </view>
          <view class="inputbar__row">
            <view class="iconbtn" hover-class="iconbtn--press" hover-stay-time="80" bindtap="chooseChatImage">＋</view>
            <input
              class="textinput"
              value="{{text}}"
              placeholder="问木薯/红薯，或发张照片识虫草"
              placeholder-class="ph"
              confirm-type="send"
              adjust-position="{{false}}"
              cursor-spacing="20"
              bindkeyboardheightchange="onKbHeight"
              bindblur="onInputBlur"
              bindinput="onChatInput"
              bindconfirm="sendChat"
            />
            <view class="sendbtn {{(text || pendingImage) && !sending ? '' : 'sendbtn--off'}}" hover-class="sendbtn--press" hover-stay-time="80" bindtap="sendChat">发送</view>
          </view>
        </view>
      </view>
    </view>
   </block>

   <!-- 智能管家：AI 自动执行 + 需要人工 -->
   <block wx:elif="{{aiOpen}}">
    <view class="detail__grab"></view>
    <view class="panel-head">
      <view class="panel-head__wrap">
        <view class="panel-head__titlerow">
          <text class="panel-head__title">小薯智能管家</text>
          <view class="ai-chip">AI</view>
        </view>
        <text class="panel-head__sub">实时调度灌溉 · 施肥 · 人工协同</text>
      </view>
      <view class="detail__close" catchtap="onCloseAiPanel">✕</view>
    </view>

    <scroll-view scroll-y class="panel-scroll" style="height:{{panelScrollH}}px">
     <view class="detail__inner">
      <!-- AI 建议卡 -->
      <view class="ai-tip">
        <view class="ai-tip__tag">✦ 小薯建议</view>
        <text class="ai-tip__text">{{aiTip}}</text>
      </view>

      <view class="detail__section-title detail__section-title--lg detail__section-title--ai">
        <text>AI 自动执行</text>
        <view class="ai-chip ai-chip--mini">全自动</view>
      </view>
      <block wx:for="{{aiActions}}" wx:key="id">
        <view class="aiact">
          <view class="aiact__dot aiact__dot--{{item.state}}"></view>
          <view class="aiact__body">
            <view class="aiact__row">
              <text class="aiact__title">{{item.plot}} · {{item.device}}</text>
              <text class="aiact__status aiact__status--{{item.state}}">{{item.statusText}}</text>
            </view>
            <text class="aiact__desc">{{item.desc}}</text>
            <view class="aibar-row">
              <view class="aibar">
                <view class="aibar__fill {{item.state === 'run' ? 'aibar__fill--run' : ''}} {{item.state === 'done' ? 'aibar__fill--done' : ''}}" style="width:{{item.progress}}%"></view>
              </view>
              <text class="aibar__pct">{{item.progress}}%</text>
            </view>
          </view>
        </view>
      </block>

      <view class="detail__section-title detail__section-title--lg">需要人工完成</view>
      <block wx:for="{{aiHumanTasks}}" wx:key="id">
        <view class="aiact aiact--human">
          <view class="aiact__dot aiact__dot--{{item.state}}"></view>
          <view class="aiact__body">
            <view class="aiact__row">
              <text class="aiact__title">{{item.plot}} · {{item.title}}</text>
              <text class="aiact__status aiact__status--{{item.state}}">{{item.statusText}}</text>
            </view>
            <text class="aiact__desc">{{item.desc}}</text>
          </view>
          <view class="aiact__owner">{{item.owner}}</view>
        </view>
      </block>
      <view class="detail__pad"></view>
     </view>
    </scroll-view>
   </block>

   <!-- AI收成预测：与网页版同一套表单 -->
   <block wx:elif="{{harvestOpen}}">
    <view class="detail__grab"></view>
    <view class="panel-head">
      <view class="panel-head__wrap">
        <view class="panel-head__titlerow"><text class="panel-head__title">AI收成预测</text><view class="ai-chip">Beta</view></view>
        <text class="panel-head__sub">比较不同年景下的收成与投入，找出真正限制这块地的因素。</text>
      </view>
      <view class="detail__close" catchtap="onCloseHarvest">✕</view>
    </view>
    <harvest-panel plot-id="{{harvestPlotId}}" height="{{panelScrollH}}" />
   </block>

   <!-- 成熟度总览：地块 → 区块下拉 -->
   <block wx:elif="{{ripeOpen}}">
    <view class="detail__grab"></view>
    <view class="panel-head">
      <view class="panel-head__wrap">
        <text class="panel-head__title">成熟度总览</text>
        <text class="panel-head__sub">AI 估算 · 按区块细分</text>
      </view>
      <view class="detail__close" catchtap="onCloseRipePanel">✕</view>
    </view>

    <scroll-view scroll-y class="panel-scroll" style="height:{{panelScrollH}}px">
     <view class="detail__inner">
      <block wx:for="{{ripePlots}}" wx:key="id">
        <view class="ripe-card">
          <view class="ripe-card__head" data-id="{{item.id}}" catchtap="onToggleRipePlot">
            <view class="ripe-card__top">
              <text class="ripe-card__name">{{item.name}}</text>
              <text class="ripe-card__pct">{{item.progress}}%</text>
              <view class="ripe-card__arrow {{item.expanded ? 'ripe-card__arrow--open' : ''}}"></view>
            </view>
            <view class="rbar">
              <view class="rbar__fill rbar__fill--total" style="width:{{item.progress}}%"></view>
            </view>
            <text class="ripe-card__meta">AI 综合估算 · {{item.blocks.length}} 个区块 · 预计 {{item.harvest}} 可收</text>
          </view>

          <view wx:if="{{item.expanded}}" class="ripe-card__blocks">
            <block wx:for="{{item.blocks}}" wx:key="id" wx:for-item="b">
              <view class="rblock">
                <view class="rblock__row">
                  <text class="rblock__name">{{b.name}}</text>
                  <text class="rblock__variety">{{b.variety}}</text>
                  <text class="rblock__owner">{{b.owner}}</text>
                  <text class="rblock__pct">{{b.progress}}%</text>
                </view>
                <view class="rbar rbar--thin">
                  <view class="rbar__fill" style="width:{{b.progress}}%"></view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>
      <view class="detail__pad"></view>
     </view>
    </scroll-view>
   </block>
   </view>
  </page-container>
</view>
