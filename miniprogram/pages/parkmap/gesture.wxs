// 渲染层手势引擎：平移园区平面 + 地块近中心放大聚焦。
// 全程用 setStyle 直接改样式，不回调 JS setData，保证丝滑。
var state = {
  inited: false,
  dragging: false,
  tx: 0, ty: 0,        // 当前平移(px)
  bx: 0, by: 0,        // 本次手势起点的平移基准
  sx: 0, sy: 0,        // 触摸起点
  moved: 0,
  vw: 375, vh: 700
}

function clamp(v, lo, hi) {
  if (v < lo) return lo
  if (v > hi) return hi
  return v
}

function ratio() { return state.vw / 750 }
function centerX() { return state.vw / 2 }
function centerY() { return state.vh * 0.46 }

// 平移边界：保证 cx∈[200,1050]、cy∈[200,860] 的地块都能被拖到中心
function bounds() {
  var r = ratio()
  return {
    minX: centerX() - 1050 * r,
    maxX: centerX() - 200 * r,
    minY: centerY() - 860 * r,
    maxY: centerY() - 200 * r
  }
}

function applyStage(owner, animate) {
  var stage = owner.selectComponent('.stage')
  if (!stage) return
  stage.setStyle({
    transform: 'translate3d(' + state.tx + 'px,' + state.ty + 'px,0)',
    transition: animate ? 'transform 460ms cubic-bezier(0.22,1,0.36,1)' : 'none'
  })
}

// 返回最近地块的 {cx, cy}（rpx），用于松手吸附
function applyPlots(owner, animate) {
  var r = ratio()
  var cx = centerX()
  var cy = centerY()
  var plots = owner.selectAllComponents('.plot')
  var n = plots.length
  if (!n) return null

  var dists = []
  var best = -1
  var bestD = 999999999
  var i, ds, sx, sy, d
  for (i = 0; i < n; i++) {
    ds = plots[i].getDataset()
    sx = ds.cx * r + state.tx
    sy = ds.cy * r + state.ty
    d = Math.sqrt((sx - cx) * (sx - cx) + (sy - cy) * (sy - cy))
    dists.push(d)
    if (d < bestD) { bestD = d; best = i }
  }

  var span = state.vw * 0.62
  for (i = 0; i < n; i++) {
    var t = dists[i] / span
    if (t > 1) t = 1
    var s = 1.12 - 0.24 * t           // 近中心 ~1.12，远端 ~0.88（柔和，远处字也清楚）
    var lift = (1 - t) * 14           // 近中心轻微上浮(px)
    plots[i].setStyle({
      transform: 'translateY(' + (-lift) + 'px) scale(' + s + ')',
      'z-index': '' + (1000 - Math.round(dists[i])),
      transition: animate ? 'transform 460ms cubic-bezier(0.22,1,0.36,1)' : 'none'
    })
    if (i === best && bestD < state.vw * 0.40) {
      plots[i].addClass('plot--focus')
    } else {
      plots[i].removeClass('plot--focus')
    }
  }

  var bd = plots[best].getDataset()
  return { cx: bd.cx, cy: bd.cy }
}

function ensureInit(e) {
  if (state.inited) return
  var d = e.currentTarget.dataset
  if (d.vw) state.vw = d.vw
  if (d.vh) state.vh = d.vh
  if (d.initx !== undefined) state.tx = d.initx
  if (d.inity !== undefined) state.ty = d.inity
  state.inited = true
}

function onTouchStart(e, owner) {
  ensureInit(e)
  state.dragging = true
  state.moved = 0
  state.bx = state.tx
  state.by = state.ty
  var tch = e.touches[0]
  state.sx = tch.clientX
  state.sy = tch.clientY
  state.lastX = tch.clientX
}

// 小花按拖动方向倾倒；松手回弹
function applyFlowers(owner, lean, spring) {
  var fs = owner.selectAllComponents('.flower')
  var i
  for (i = 0; i < fs.length; i++) {
    fs[i].setStyle({
      transform: 'rotate(' + lean + 'deg)',
      transition: spring ? 'transform 700ms cubic-bezier(0.34,1.56,0.64,1)' : 'transform 90ms linear'
    })
  }
}

function onTouchMove(e, owner) {
  if (!state.dragging) return
  var tch = e.touches[0]
  var dx = tch.clientX - state.sx
  var dy = tch.clientY - state.sy
  var m = Math.abs(dx) + Math.abs(dy)
  if (m > state.moved) state.moved = m
  var b = bounds()
  state.tx = clamp(state.bx + dx, b.minX, b.maxX)
  state.ty = clamp(state.by + dy, b.minY, b.maxY)
  applyStage(owner, false)
  applyPlots(owner, false)
  // 按本帧水平位移让小花倾倒
  var ldx = tch.clientX - state.lastX
  state.lastX = tch.clientX
  applyFlowers(owner, clamp(ldx * 1.4, -16, 16), false)
}

function onTouchEnd(e, owner) {
  if (!state.dragging) return
  state.dragging = false
  applyFlowers(owner, 0, true)
  // 松手吸附到最近地块中心
  var nearest = applyPlots(owner, true)
  if (nearest) {
    var r = ratio()
    var b = bounds()
    state.tx = clamp(centerX() - nearest.cx * r, b.minX, b.maxX)
    state.ty = clamp(centerY() - nearest.cy * r, b.minY, b.maxY)
    applyStage(owner, true)
    applyPlots(owner, true)
  }
  owner.callMethod('syncOffset', { tx: state.tx, ty: state.ty })
}

module.exports = {
  onTouchStart: onTouchStart,
  onTouchMove: onTouchMove,
  onTouchEnd: onTouchEnd
}
