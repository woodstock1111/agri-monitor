@import "../../components/agent-chat/agent-chat.wxss";
/* Artistic terrain stays full bleed. Controls share one quiet paper surface. */
.map-root { position:fixed;top:0;right:0;bottom:0;left:0;width:100%;height:100%;overflow:hidden;background:#f2efde;color:#354b3d;transition:opacity 160ms ease; }
.map-area { position:absolute;left:0;z-index:0;overflow:hidden;opacity:0;transition:opacity 400ms ease; }
.map-root--ready .map-area { opacity:1; }
.map-box { overflow:visible; }
.map-world { position:absolute; }
.map-art { position:absolute;left:0;top:0;display:block; }
/* Pre-rendered fluorescent halo; only the highlighted plot's is shown. */
.plot-glow { position:absolute;display:block;opacity:0;transition:opacity 220ms ease;pointer-events:none; }
.plot-glow--on { opacity:1; }
/* Two-line tag at each plot's centre: name, then variety. Taps fall through to the map. */
.plot-tag { position:absolute;transform:translate(-50%,-50%);display:flex;align-items:center;gap:10rpx;padding:8rpx 20rpx 8rpx 14rpx;border-radius:18rpx;background:rgba(252,249,238,.9);border:2rpx solid rgba(47,74,54,.14);box-shadow:0 2rpx 8rpx rgba(40,50,30,.18);white-space:nowrap;pointer-events:none;transition:background 220ms ease,border-color 220ms ease,box-shadow 220ms ease; }
.plot-tag--on { background:rgba(253,255,240,.98);border-color:rgba(214,240,120,.95);box-shadow:0 0 14rpx rgba(226,255,150,.9),0 2rpx 8rpx rgba(40,50,30,.18); }
.plot-tag__dot { width:14rpx;height:14rpx;border-radius:50%;flex-shrink:0;box-shadow:0 0 0 2rpx rgba(47,74,54,.3); }
.plot-tag__text { display:flex;flex-direction:column;line-height:1.25; }
.plot-tag__name { font-size:24rpx;font-weight:600;color:#2f4a36;max-width:180rpx;overflow:hidden;text-overflow:ellipsis; }
.plot-tag__crop { font-size:19rpx;color:#687568; }
/* Fog over everything outside the unlocked area: one gradient wash plus cloud puffs along its edge.
   Unlocking cross-fades two layers (opacity only, GPU); no runtime blur. */
.fog-layer { position:absolute;left:0;top:0;pointer-events:none;opacity:1;transition:opacity 1600ms ease; }
.fog-layer--hidden { opacity:0; }
.fog-wash { position:absolute;left:0; }
.fog-puff { position:absolute;display:block; }
.fog-puff--flip { transform:scaleX(-1); }
.plot-tag__alarm { position:absolute;top:-6rpx;right:-6rpx;width:14rpx;height:14rpx;border-radius:50%;background:#b5482f;border:3rpx solid #fffcef; }
/* Entry: a paper veil fades while three clouds drift apart. Transform/opacity only. */
.intro { position:absolute;left:0;right:0;z-index:4;overflow:hidden;pointer-events:none;background-color:rgba(242,239,222,1);transition:background-color 600ms ease 150ms; }
.intro--open { background-color:rgba(242,239,222,0); }
.intro__cloud { position:absolute;display:block;top:-10%;width:130%;height:120%;opacity:1;transition:transform 1300ms cubic-bezier(.3,.6,.2,1),opacity 1100ms ease 200ms; }
.intro__cloud--l { left:-60%; }
.intro__cloud--r { right:-60%;transform:scaleX(-1); }
.intro__cloud--c { left:-15%;top:10%;height:80%; }
.intro--open .intro__cloud { opacity:0; }
.intro--open .intro__cloud--l { transform:translateX(-55%); }
.intro--open .intro__cloud--r { transform:scaleX(-1) translateX(-55%); }
.intro--open .intro__cloud--c { transform:scale(1.5); }
.topbar { position:absolute;top:0;left:0;right:0;z-index:5;padding:0 30rpx 12rpx;background:#f2efde; }
.topbar__heading { display:flex;align-items:center;gap:6rpx;padding-right:200rpx;min-height:88rpx; }
.topbar__back { flex-shrink:0;width:56rpx;height:88rpx;display:flex;align-items:center;justify-content:center;font-size:48rpx;line-height:1;color:#2f4a36; }
.topbar__title { font-size:44rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:2rpx;color:#2f4a36; }
.topbar__subrow { display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-left:14rpx;min-height:88rpx; }
.topbar__count { font-size:26rpx;font-weight:600;color:#354b3d;white-space:nowrap; }
.topbar__ledger { flex-shrink:0;font-size:24rpx;height:60rpx;display:flex;align-items:center;padding:0 24rpx;white-space:nowrap;color:#2f4a36;border:1rpx solid rgba(47,74,54,.45);border-radius:30rpx;background:rgba(252,249,238,.7); }
/* One paper panel below the map carries the plot switcher and the four entries. */
.park-shelf { position:absolute;left:0;right:0;bottom:0;z-index:8;padding:0 30rpx;background:#fbf8ee;border-top:1rpx solid rgba(92,78,44,.14);transition:transform 280ms cubic-bezier(.4,0,.2,1),opacity 220ms ease; }
.park-shelf--hidden { opacity:0;transform:translateY(16rpx);pointer-events:none; }
.plot-selector { display:flex;align-items:center;height:120rpx;gap:4rpx;border-bottom:1rpx solid rgba(53,75,61,.14);overflow:hidden; }
.selector-arrow { width:60rpx;min-height:88rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:44rpx;line-height:1;color:#2f4a36; }
.selector-arrow--disabled { opacity:.25; }
.selector-info { flex:1;min-width:0;display:flex;align-items:center;gap:18rpx; }
.selector-swatch { flex-shrink:0;width:44rpx;height:44rpx;border-radius:12rpx;border:4rpx solid #efe3c0;box-shadow:0 0 0 1rpx rgba(92,78,44,.35); }
.selector-text { flex:1;min-width:0;display:flex;flex-direction:column;gap:2rpx; }
.selector-name { font-size:34rpx;font-weight:700;color:#2f4a36;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; }
.selector-meta { font-size:23rpx;color:#687568;overflow:hidden;white-space:nowrap;text-overflow:ellipsis; }
.selector-info--a { animation:selectorInA 220ms ease both; }
.selector-info--b { animation:selectorInB 220ms ease both; }
@keyframes selectorInA { from { opacity:.2;transform:translateX(14rpx); } to { opacity:1;transform:translateX(0); } }
@keyframes selectorInB { from { opacity:.2;transform:translateX(-14rpx); } to { opacity:1;transform:translateX(0); } }
.selector-enter { margin-left:8rpx;height:68rpx;min-width:128rpx;padding:0 24rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:26rpx;font-weight:600;color:#fffcef;background:#2f4a36;border-radius:34rpx; }
.park-nav { display:flex;align-items:center;padding:10rpx 0 12rpx; }
.park-nav__item { flex:1;min-width:0;min-height:100rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;font-size:22rpx;line-height:1.4;color:#354b3d;white-space:nowrap;transition:transform 100ms ease,opacity 100ms ease; }
.park-nav__icon { width:42rpx;height:42rpx; }
.control--press { opacity:.65;transform:scale(.96); }
.map-state { position:absolute;left:0;right:0;top:42%;display:flex;flex-direction:column;align-items:center;gap:24rpx;font-size:26rpx;color:#526f54; }
.map-state__mark { width:38rpx;height:38rpx;border:3rpx solid #bbc8a6;border-top-color:#526f54;border-radius:50%;animation:btnSpin .8s linear infinite; }
.map-state__retry { padding:20rpx 36rpx;border:1rpx solid #7f9270;border-radius:40rpx; }
.map-empty { position:absolute;top:40%;left:12%;right:12%;padding:36rpx;text-align:center;display:flex;flex-direction:column;gap:12rpx;border-radius:24rpx;background:rgba(242,239,222,.95); }
.map-empty__sub { font-size:24rpx;color:#687568; }
.map-root--ready .topbar { animation:parkControlsIn 400ms ease both; }
.park-shelf { opacity:1; }
@keyframes parkControlsIn { from { opacity:0;transform:translateY(12rpx); } to { opacity:1;transform:translateY(0); } }
/* State transitions must override initial entry keyframes. */
.map-root--ready .park-shelf--hidden { animation:none;opacity:0;transform:translateY(16rpx); }
.map-root--leaving { opacity:0;pointer-events:none; }
.map-root--return { animation:parkReturn 280ms ease both; }
@keyframes parkReturn { from { opacity:.4; } to { opacity:1; } }
.sheet-content { height:100%;overflow:hidden; }
.detail__inner,.panel-head,.detail__head { animation:sheetContentIn 240ms ease both; }
@keyframes sheetContentIn { from { opacity:.4;transform:translateY(10rpx); } to { opacity:1;transform:translateY(0); } }
.detail__grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(53, 75, 61, 0.22);
  margin: 16rpx auto 4rpx;
  flex-shrink: 0;
}
.detail__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 36rpx 16rpx;
  flex-shrink: 0;
}
.detail__title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #354b3d;
}
.detail__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #687568;
  letter-spacing: 0.3rpx;
  line-height: 1.5;
}
.detail__meta--dim { color: #7e8778; margin-top: 2rpx; }
.detail__close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(53, 75, 61, 0.07);
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  color: #526454;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.detail__scroll {
  width: 100%;
  box-sizing: border-box;
}
/* 内容自己留白，滚动条贴在最右、不压到卡片 */
.detail__inner {
  padding: 0 36rpx;
}
/* editorial eyebrow：赤陶短杠 + 细字距小标 */
.detail__section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #526454;
  margin: 26rpx 0 16rpx;
}
.detail__section-title::before {
  content: '';
  width: 28rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #b68169;
}
.detail__section-title--row .add-btn {
  margin-left: auto;
}
.add-btn {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
  background: #526f54;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}
.detail__empty {
  padding: 28rpx;
  text-align: center;
  color: #7e8778;
  font-size: 24rpx;
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.12);
  border-radius: 20rpx;
}

.sensor-dev {
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.sensor-dev__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sensor-dev__name { font-size: 26rpx; font-weight: 700; color: #354b3d; letter-spacing: 0.5rpx; }
.sensor-dev__state { font-size: 22rpx; color: #526f54; letter-spacing: 1rpx; }
.sensor-dev__state--off { color: #7e8778; }
.sensor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.sfactor {
  background: #e9e8d8;
  border: 1rpx solid rgba(53, 75, 61, 0.10);
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sfactor__name { font-size: 22rpx; color: #687568; letter-spacing: 1rpx; }
.sfactor__val { font-size: 38rpx; font-weight: 800; color: #354b3d; line-height: 1; letter-spacing: -0.5rpx; }
.sfactor__unit { font-size: 20rpx; font-weight: 600; margin-left: 4rpx; color: #7e8778; }
.sfactor--lv2 { background: #f0e4c2; border-color: rgba(169,118,42,0.24); }
.sfactor--lv2 .sfactor__val { color: #a9762a; }
.sfactor--lv3 { background: #ecd7cc; border-color: rgba(176,80,58,0.24); }
.sfactor--lv3 .sfactor__val { color: #b0503a; }

.dtask {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 14rpx;
}
.dtask--done { opacity: 0.6; }
.dtask__body { flex: 1; min-width: 0; }
.dtask__title { font-size: 28rpx; font-weight: 600; color: #354b3d; letter-spacing: 0.3rpx; line-height: 1.5; }
.dtask--done .dtask__title { text-decoration: line-through; color: #7e8778; }
.dtask__why { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 10rpx; }
.dtask__why-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #b06a3a;
  background: #f0e0d2;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
.dtask__why-text { font-size: 22rpx; color: #687568; line-height: 1.5; }
.dtask__tags { display: flex; gap: 10rpx; margin-top: 12rpx; }
.dtask__tag {
  font-size: 20rpx;
  color: #7e8778;
  background: #e4e6d5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5rpx;
}
.dtask__tag--ai { color: #b06a3a; background: #f0e0d2; }
.dtask__done-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #526f54;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
}
.dtask__done-btn--press { transform: scale(0.94); }
.dtask__done-tag { flex-shrink: 0; font-size: 22rpx; color: #526f54; font-weight: 700; }
.detail__pad { height: 24rpx; }

/* ===== 面板通用头部 ===== */
.panel-head {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 36rpx 18rpx;
}
.panel-head__wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.panel-head__titlerow { display: flex; align-items: center; gap: 14rpx; }
.panel-head__title { font-size: 38rpx; font-weight: 800; color: #354b3d; letter-spacing: 1rpx; }
.panel-head__sub { font-size: 22rpx; color: #7e8778; letter-spacing: 0.5rpx; }
.panel-scroll { width: 100%; box-sizing: border-box; }

/* AI 渐变徽标 */
.ai-chip {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(120deg, #7f9270, #75aaa4);
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(82, 111, 84, 0.30);
}
.ai-chip--mini { font-size: 19rpx; padding: 3rpx 12rpx; letter-spacing: 1rpx; }

/* 面板里的小标题：加大一号 */
.detail__section-title--lg { font-size: 29rpx; letter-spacing: 2rpx; color: #354b3d; margin: 34rpx 0 18rpx; }
.detail__section-title--ai::before { background: linear-gradient(90deg, #7f9270, #75aaa4); }

/* ===== 智能管家 ===== */
.ai-tip {
  background: linear-gradient(135deg, rgba(127, 146, 112, 0.10), rgba(117, 170, 164, 0.10)), #fbf8ee;
  border: 1rpx solid rgba(82, 111, 84, 0.26);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.ai-tip__tag {
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(120deg, #7f9270, #75aaa4);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.ai-tip__text { font-size: 25rpx; color: #5a4c3b; line-height: 1.6; }

.aiact {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 14rpx;
}
.aiact__dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #7e8778;
}
.aiact__dot--run {
  background: #526f54;
  animation: dotPulse 1.4s ease-in-out infinite;
}
.aiact__dot--wait { background: #a9762a; }
.aiact__dot--done { background: #9ca48e; }
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(95, 122, 78, 0.35); }
  50%      { box-shadow: 0 0 0 8rpx rgba(95, 122, 78, 0); }
}
.aiact__body { flex: 1; min-width: 0; }
.aiact__row { display: flex; align-items: center; gap: 12rpx; }
.aiact__title { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 700; color: #354b3d; }
.aiact__status { flex-shrink: 0; font-size: 21rpx; font-weight: 700; letter-spacing: 0.5rpx; padding: 3rpx 14rpx; border-radius: 999rpx; }
.aiact__status--run  { color: #4e6a3f; background: #e2e8cf; }
.aiact__status--wait { color: #a9762a; background: #f0e4c2; }
.aiact__status--done { color: #7e8778; background: #e4e6d5; }
.aiact__desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: #687568; line-height: 1.55; }
/* 执行进度条：纸面凹槽 + AI 渐变填充，进行中带流光 */
.aibar-row { display: flex; align-items: center; gap: 16rpx; margin-top: 14rpx; }
.aibar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: #dedfcd;
  border: 1rpx solid rgba(53, 75, 61, 0.10);
  overflow: hidden;
}
.aibar__fill {
  position: relative;
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(120deg, #7f9270, #75aaa4);
  transition: width 400ms cubic-bezier(0.32, 0.72, 0, 1);
}
.aibar__fill--done { background: linear-gradient(90deg, #a9b893, #526f54); }
.aibar__fill--run::after {
  content: '';
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  animation: aibarSheen 1.6s ease-in-out infinite;
}
@keyframes aibarSheen {
  0%   { left: -40%; }
  100% { left: 110%; }
}
.aibar__pct { flex-shrink: 0; min-width: 64rpx; text-align: right; font-size: 24rpx; font-weight: 800; color: #526f54; letter-spacing: -0.5rpx; }
/* 人工任务的负责人小标 */
.aiact__owner {
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 700;
  color: #526454;
  background: #e4e6d5;
  border: 1rpx solid rgba(53, 75, 61, 0.12);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

/* ===== 成熟度总览 ===== */
.ripe-card {
  background: #fbf8ee;
  border: 1rpx solid rgba(53, 75, 61, 0.14);
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}
.ripe-card:first-child { margin-top: 8rpx; }
.ripe-card__top { display: flex; align-items: center; gap: 14rpx; }
.ripe-card__name { flex: 1; font-size: 30rpx; font-weight: 800; color: #354b3d; letter-spacing: 0.5rpx; }
.ripe-card__pct { font-size: 32rpx; font-weight: 800; color: #526f54; letter-spacing: -0.5rpx; }
.ripe-card__arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #7e8778;
  border-bottom: 3rpx solid #7e8778;
  transform: rotate(45deg);
  margin-top: -6rpx;
  transition: transform 200ms ease;
}
.ripe-card__arrow--open { transform: rotate(-135deg); margin-top: 6rpx; }
.ripe-card__meta { display: block; margin-top: 12rpx; font-size: 21rpx; color: #7e8778; letter-spacing: 0.5rpx; }
/* 进度条：纸面凹槽 + 赤陶/墨绿填充 */
.rbar {
  margin-top: 16rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #dedfcd;
  border: 1rpx solid rgba(53, 75, 61, 0.10);
  overflow: hidden;
}
.rbar--thin { height: 12rpx; margin-top: 10rpx; }
.rbar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #a9b893, #526f54);
  transition: width 400ms cubic-bezier(0.32, 0.72, 0, 1);
}
.rbar__fill--total { background: linear-gradient(90deg, #d9a06b, #526f54); }
/* 区块列表 */
.ripe-card__blocks {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed rgba(53, 75, 61, 0.18);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rblock__row { display: flex; align-items: baseline; gap: 12rpx; }
.rblock__name { font-size: 25rpx; font-weight: 700; color: #354b3d; }
.rblock__variety { font-size: 20rpx; color: #b06a3a; background: #f0e0d2; padding: 2rpx 10rpx; border-radius: 8rpx; }
.rblock__owner { flex: 1; font-size: 21rpx; color: #7e8778; }
.rblock__pct { font-size: 24rpx; font-weight: 800; color: #526f54; }

/* 收成预测按键图标：三根柱子 */
.icon-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 36rpx;
}
.icon-bars__bar {
  width: 10rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #3f7d62;
}
.icon-bars__bar--1 { height: 14rpx; }
.icon-bars__bar--2 { height: 24rpx; }
.icon-bars__bar--3 { height: 36rpx; }

.ripe-card__blocks { animation:sheetContentIn 220ms ease both; }

/* Effective touch areas stay at least 44 px on 320 px screens. */
.detail__close,.agent-close { min-width:44px;min-height:44px; }
.topbar__title { font-family:'Songti SC','STSong',serif; }
.selector-arrow { min-height:44px; }
@media (max-width:360px) {
 .selector-swatch { width:36rpx;height:36rpx; }
 .selector-name { font-size:30rpx; }
}
