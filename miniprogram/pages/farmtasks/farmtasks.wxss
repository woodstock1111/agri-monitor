.farm-page {
  min-height: 100vh;
  background: var(--bg-base);
  color: var(--text-primary);
  position: relative;
  overflow: hidden;
}

.app-title {
  padding: 28rpx 24rpx 0 40rpx;
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
}

.title-add {
  width: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-lg);
  font-weight: 600;
  line-height: 60rpx;
  box-shadow: 0 4rpx 12rpx var(--accent-glow);
  transition: transform var(--dur-micro) var(--ease),
              background var(--dur-micro) var(--ease);
}

.title-add::after {
  border: none;
}

.title-add--press {
  transform: scale(0.94);
  background: var(--accent-press);
}

.date-strip {
  width: 100%;
  white-space: nowrap;
  padding: 32rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.date-chip {
  width: 112rpx;
  min-height: 136rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-surface);
  color: var(--text-secondary);
  transition: transform var(--dur-micro) var(--ease),
              background var(--dur-state) var(--ease),
              border-color var(--dur-state) var(--ease);
}

.date-chip--active,
.date-chip--today.date-chip--active {
  background: var(--accent);
  border-color: var(--accent);
}

.date-chip--press {
  transform: scale(0.97);
  background: var(--bg-hover);
}

.date-chip__weekday {
  font-size: var(--fs-caption);
  color: var(--text-muted);
}

.date-chip__day {
  margin-top: 4rpx;
  font-size: var(--fs-lg);
  line-height: 1.1;
  font-weight: 700;
  color: var(--text-primary);
}

.date-chip--active .date-chip__weekday,
.date-chip--active .date-chip__day {
  color: var(--text-inverse);
}

.date-chip__foot {
  height: 18rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
}

.date-chip__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--success);
}

.date-chip--active .date-chip__dot {
  background: var(--text-inverse);
}

.date-chip__count {
  font-size: 18rpx;
  line-height: 1;
  color: var(--text-muted);
}

.date-chip--active .date-chip__count {
  color: var(--text-inverse);
}

.content-scroll {
  height: calc(100vh - 220rpx);
  padding: 8rpx 40rpx calc(196rpx + var(--safe-bottom));
  box-sizing: border-box;
}

.section {
  background: var(--bg-panel);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 36rpx 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: var(--gap-md);
  box-sizing: border-box;
  animation: sectionIn 350ms var(--ease);
}

.section--cool {
  background: var(--bg-cool);
}

.section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
  margin-bottom: 28rpx;
}

.section__title {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  font-size: var(--fs-md);
  font-weight: 700;
}

.section__title-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--accent);
  color: var(--text-inverse);
  font-size: var(--fs-body);
}

.section__title-ico--ai {
  background: var(--info);
}

.section__title-ico--user {
  background: var(--accent-2);
}

.section__count {
  font-size: var(--fs-caption);
  color: var(--text-muted);
  font-weight: 500;
  white-space: nowrap;
}

.section__act {
  padding: 12rpx 20rpx;
  border-radius: var(--radius-pill);
  color: var(--accent);
  font-size: var(--fs-caption);
  white-space: nowrap;
}

.section__act--press {
  background: var(--bg-hover);
  transform: scale(0.97);
}

.section-empty {
  color: var(--text-muted);
  font-size: var(--fs-body);
  padding: 24rpx 0 4rpx;
  text-align: center;
}

.task {
  position: relative;
  overflow: hidden;
  background: var(--bg-surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: transform var(--dur-state) var(--ease),
              opacity var(--dur-state) var(--ease),
              border-color var(--dur-state) var(--ease),
              background var(--dur-state) var(--ease);
}

.task:last-child {
  margin-bottom: 0;
}

.task--rec {
  background: var(--bg-surface);
}

.task--cool {
  background: var(--bg-surface);
}

.task--press {
  transform: scale(0.985);
  background: var(--bg-hover);
}

.task--overdue {
  border-color: var(--danger);
}

.task__alert-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--danger);
}

.task--done {
  opacity: 0.6;
  transform: translateY(8rpx);
}

.task--with-check {
  padding-left: 96rpx;
}

.task__check {
  position: absolute;
  left: 28rpx;
  top: 50%;
  width: 48rpx;
  height: 48rpx;
  margin-top: -24rpx;
  border: 4rpx solid var(--success);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--success);
  font-size: var(--fs-md);
  font-weight: 700;
  z-index: 2;
  animation: drawCheck 320ms var(--ease) forwards;
}

.task__ripple {
  position: absolute;
  right: 48rpx;
  bottom: 34rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-pill);
  background: var(--success-bg);
  animation: taskRipple 300ms var(--ease) forwards;
}

.task__row1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}

.task__title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.45;
  font-weight: 600;
  color: var(--text-primary);
}

.task--done .task__title {
  color: var(--text-muted);
  text-decoration: line-through;
}

.task__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--warning);
  color: var(--text-inverse);
  font-size: var(--fs-caption);
  font-weight: 700;
}

.task__avatar--danger {
  background: var(--danger);
}

.task__why {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.task__why-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--accent-light);
  color: var(--accent);
  font-size: var(--fs-caption);
  font-weight: 700;
}

.task__why-text {
  flex: 1;
  color: var(--text-secondary);
  font-size: var(--fs-caption);
  line-height: 1.55;
}

.task__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}

.task__chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-light);
  color: var(--accent);
  font-size: var(--fs-caption);
  font-weight: 500;
}

.task__chip--time {
  background: var(--bg-base);
  color: var(--text-secondary);
}

.task__chip--overdue {
  background: var(--danger-bg);
  color: var(--danger);
}

.task__chip--done {
  background: var(--success-bg);
  color: var(--success);
}

.task__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.ai-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.act-btn {
  min-height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--bg-surface);
  color: var(--text-secondary);
  font-size: var(--fs-caption);
  font-weight: 600;
  line-height: 56rpx;
}

.act-btn::after,
.btn-done::after,
.btn-empty::after,
.undo-toast__btn::after {
  border: none;
}

.act-btn--primary {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--text-inverse);
}

.act-btn--press {
  transform: scale(0.97);
  background: var(--bg-hover);
}

.act-btn--primary-press {
  transform: scale(0.97);
  background: var(--accent-press);
}

.task__owner-text {
  min-width: 0;
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--text-muted);
}

.task__owner-text--danger {
  color: var(--danger);
}

.btn-done {
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 96rpx;
  box-shadow: 0 8rpx 20rpx var(--accent-glow);
}

.btn-done--press,
.btn-done--press[disabled] {
  transform: scale(0.92);
}

.btn-done--rebound {
  background: var(--success);
  animation: doneBounce 360ms var(--ease);
}

.btn-done--done {
  background: var(--text-muted);
  box-shadow: none;
}

.btn-done--warning {
  background: var(--warning);
}

.loading-card {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-sm);
  background: var(--bg-panel);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  color: var(--text-muted);
}

.loading-spin {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--accent-light);
  border-top-color: var(--accent);
  border-radius: var(--radius-pill);
  animation: btnSpin 800ms linear infinite;
}

.empty {
  min-height: 640rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 48rpx 80rpx;
  color: var(--text-muted);
  box-sizing: border-box;
}

.empty__illus {
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 36rpx;
}

.empty__title {
  font-size: var(--fs-md);
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty__sub {
  font-size: var(--fs-body);
  color: var(--text-muted);
  margin-bottom: 44rpx;
}

.btn-empty {
  min-height: 72rpx;
  margin: 0;
  padding: 0 48rpx;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: var(--text-inverse);
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 72rpx;
  box-shadow: 0 8rpx 20rpx var(--accent-glow);
}

.btn-empty--press {
  transform: scale(0.97);
  background: var(--accent-press);
}

.undo-toast {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(184rpx + var(--safe-bottom));
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  background: var(--text-primary);
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  opacity: 0;
  transform: translateY(16rpx);
  pointer-events: none;
  transition: opacity 250ms var(--ease),
              transform 250ms var(--ease);
  z-index: 30;
  box-sizing: border-box;
}

.undo-toast--open {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.undo-toast__text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.undo-toast__btn {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--warning);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1;
}

@keyframes sectionIn {
  from {
    opacity: 0;
    transform: translateX(20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes taskRipple {
  0% {
    transform: scale(0);
    opacity: 0.45;
  }
  100% {
    transform: scale(4);
    opacity: 0;
  }
}
